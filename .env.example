# Скопируйте этот файл в .env и поправьте значения. Все параметры необязательные.

# Порт и адрес, на которых слушает сервер
PORT=3000
HOST=0.0.0.0

# Публичный адрес сайта — по нему строятся QR-коды столов. Обязательно задайте на боевом сервере.
# Без него адрес берётся из того, как вы открыли админку.
PUBLIC_URL=https://dacha.example.ru

# Пароль администратора. Если не задать — при первом запуске сгенерируется и покажется в консоли.
# После первого входа пароль хранится в data/config.json (хеш) и меняется в админке.
ADMIN_PASSWORD=

# Пароль повара: после входа видит только стоп-лист. Можно задать позже в админке.
KITCHEN_PASSWORD=

# Telegram можно настроить в админке (Настройки → Telegram) — тогда эти строки не нужны.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DELIVERY_CHAT_ID=

# Если сервер не достаёт до api.telegram.org — адрес вашего прокси к Bot API
# TELEGRAM_API_BASE=https://tg-proxy.example.ru

# Если сайт стоит за nginx/Caddy — чтобы лимиты считались по реальному IP гостя
# TRUST_PROXY=1

# Где хранить данные (меню, заказы, фото). По умолчанию ./data
# DATA_DIR=/var/lib/dacha
